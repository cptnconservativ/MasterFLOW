<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MasterFlow.Desktop.ViewModels"
        xmlns:c="using:MasterFlow.Desktop.Controls"
        xmlns:app="using:MasterFlow.Application"
        x:Class="MasterFlow.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource MfPane}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}"/>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportReportCommand}"/>
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}"/>
    <KeyBinding Gesture="Ctrl+T" Command="{Binding AddCalculationCommand}"/>
  </Window.KeyBindings>

  <DockPanel>
    <!-- Command bar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource MfCard}" BorderBrush="{DynamicResource MfRule}" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="MasterFlow" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="4,0,16,0" Foreground="{DynamicResource MfAccent}"/>
        <Button Content="New" Command="{Binding NewProjectCommand}" ToolTip.Tip="New project (Ctrl+N)"/>
        <Button Content="Open…" Command="{Binding OpenCommand}" ToolTip.Tip="Open project (Ctrl+O)"/>
        <Button Content="Save" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)"/>
        <Button Content="Save as…" Command="{Binding SaveAsCommand}" ToolTip.Tip="Save as (Ctrl+Shift+S)"/>
        <Rectangle Width="1" Fill="{DynamicResource MfRule}" Margin="8,2"/>
        <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)"/>
        <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)"/>
        <Rectangle Width="1" Fill="{DynamicResource MfRule}" Margin="8,2"/>
        <Button Content="Copy results" Command="{Binding CopyResultsCommand}" ToolTip.Tip="Copy results as tab-separated text"/>
        <Button Content="Report…" Command="{Binding ExportReportCommand}" ToolTip.Tip="Export the selected calculation report (Ctrl+E)"/>
        <Button Content="Batch report…" Command="{Binding ExportAllReportsCommand}" ToolTip.Tip="One report containing every calculation"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource MfCard}" BorderBrush="{DynamicResource MfRule}" BorderThickness="0,1,0,0" Padding="10,4">
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.8"/>
    </Border>

    <Grid ColumnDefinitions="260,4,*,4,370">
      <!-- Project navigator -->
      <DockPanel Grid.Column="0" Margin="8">
        <Expander DockPanel.Dock="Top" Header="Project information" Margin="0,0,0,8" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <TextBox Watermark="Project name" Text="{Binding ProjectName}"/>
            <TextBox Watermark="Project number" Text="{Binding ProjectNumber}"/>
            <TextBox Watermark="Client" Text="{Binding Client}"/>
            <TextBox Watermark="Prepared by" Text="{Binding PreparedBy}"/>
            <TextBox Watermark="Checked by" Text="{Binding CheckedBy}"/>
            <TextBox Watermark="Report notes" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
            <TextBox Watermark="Report watermark (e.g. PRELIMINARY)" Text="{Binding Watermark}"/>
            <TextBox Watermark="Report footer text" Text="{Binding FooterText}"/>
          </StackPanel>
        </Expander>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
          <Button Content="+ Channel" Command="{Binding AddCalculationCommand}" ToolTip.Tip="Add calculation (Ctrl+T)"/>
          <Button Content="Duplicate" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate (Ctrl+D)"/>
          <Button Content="Delete" Command="{Binding DeleteCommand}"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Calculations}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CalculationViewModel">
              <StackPanel Margin="0,2">
                <TextBlock Text="{Binding ListLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding ListDetail}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="{DynamicResource MfRule}"/>

      <!-- Calculation editor -->
      <ScrollViewer Grid.Column="2" IsVisible="{Binding HasSelection}">
        <StackPanel Margin="8" Spacing="8" DataContext="{Binding Selected}" x:DataType="vm:CalculationViewModel">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBox Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Watermark="Calculation title"/>
              <TextBox Text="{Binding Description}" Watermark="Description (appears on the report)" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,8,*">
            <Border Classes="card" Grid.Column="0">
              <StackPanel>
                <TextBlock Classes="h2" Text="Section" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Classes="label" Text="Shape"/>
                  <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:CalculationViewModel.Shapes}" SelectedItem="{Binding Shape}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <TextBlock Grid.Row="1" Classes="label" Text="Units"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:CalculationViewModel.UnitSystems}" SelectedItem="{Binding Units}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <TextBlock Grid.Row="2" Classes="label" Text="Bottom width b" IsVisible="{Binding ShowBottomWidth}"/>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowBottomWidth}">
                    <TextBox Classes="num" Text="{Binding BottomWidth}"/><TextBlock Classes="unit" Text="{Binding LengthUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="3" Classes="label" Text="Left slope zL" IsVisible="{Binding ShowSideSlopes}"/>
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowSideSlopes}">
                    <TextBox Classes="num" Text="{Binding LeftSlope}"/><TextBlock Classes="unit" Text="H : 1 V"/>
                  </StackPanel>
                  <TextBlock Grid.Row="4" Classes="label" Text="Right slope zR" IsVisible="{Binding ShowSideSlopes}"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowSideSlopes}">
                    <TextBox Classes="num" Text="{Binding RightSlope}"/><TextBlock Classes="unit" Text="H : 1 V"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Classes="label" Text="Diameter D" IsVisible="{Binding IsPipe}"/>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsPipe}">
                    <TextBox Classes="num" Text="{Binding Diameter}"/><TextBlock Classes="unit" Text="{Binding DiameterUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="5" Classes="label" Text="Channel depth" IsVisible="{Binding ShowChannelDepth}"/>
                  <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowChannelDepth}">
                    <TextBox Classes="num" Text="{Binding ChannelDepth}" Watermark="optional"/><TextBlock Classes="unit" Text="{Binding LengthUnit}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card" Grid.Column="2">
              <StackPanel>
                <TextBlock Classes="h2" Text="Flow" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Classes="label" Text="Solve for"/>
                  <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:CalculationViewModel.SolveModes}" SelectedItem="{Binding SolveFor}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <TextBlock Grid.Row="1" Classes="label" Text="Manning's n"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Classes="num" Text="{Binding ManningN}" IsVisible="{Binding RoughnessIsInput}"/><Border IsVisible="{Binding !RoughnessIsInput}" Background="{DynamicResource MfSolved}" CornerRadius="3" Padding="8,5" MinWidth="110"><TextBlock Text="{Binding SolvedValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Border>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Classes="label" Text="Slope S"/>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Classes="num" Text="{Binding SlopePercent}" IsVisible="{Binding SlopeIsInput}"/><Border IsVisible="{Binding !SlopeIsInput}" Background="{DynamicResource MfSolved}" CornerRadius="3" Padding="8,5" MinWidth="110"><TextBlock Text="{Binding SolvedValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Border><TextBlock Classes="unit" Text="%"/>
                  </StackPanel>
                  <TextBlock Grid.Row="3" Classes="label" Text="Discharge Q"/>
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Classes="num" Text="{Binding Discharge}" IsVisible="{Binding DischargeIsInput}"/><Border IsVisible="{Binding !DischargeIsInput}" Background="{DynamicResource MfSolved}" CornerRadius="3" Padding="8,5" MinWidth="110"><TextBlock Text="{Binding SolvedValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Border><TextBlock Classes="unit" Text="{Binding DischargeUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="4" Classes="label" Text="Depth y"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Classes="num" Text="{Binding Depth}" IsVisible="{Binding DepthIsInput}"/><Border IsVisible="{Binding !DepthIsInput}" Background="{DynamicResource MfSolved}" CornerRadius="3" Padding="8,5" MinWidth="110"><TextBlock Text="{Binding SolvedValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Border><TextBlock Classes="unit" Text="{Binding LengthUnit}"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="The highlighted field is the unknown being solved for." FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card" Height="330">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <CheckBox DockPanel.Dock="Right" Content="True scale" x:Name="TrueScaleBox"/>
                <TextBlock Classes="h2" Text="Cross-section" Margin="0"/>
              </DockPanel>
              <c:CrossSectionView Drawing="{Binding Drawing}" Section="{Binding CurrentSection}" LengthUnit="{Binding LengthUnit}"
                                  TrueScale="{Binding #TrueScaleBox.IsChecked, FallbackValue=False}"/>
            </DockPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="h2" Text="Messages" Margin="0,0,0,4"/>
              <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MessageItem">
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <Expander Header="Calculation trace (method, bracket, iterations)" HorizontalAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding Trace}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Margin="0,1"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="3" Background="{DynamicResource MfRule}"/>

      <!-- Results + rating table -->
      <TabControl Grid.Column="4" Margin="4,0,8,8" IsVisible="{Binding HasSelection}">
        <TabItem Header="Results">
          <ScrollViewer>
            <StackPanel DataContext="{Binding Selected}" x:DataType="vm:CalculationViewModel">
              <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding ResultLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:ResultLine">
                    <Border Padding="6,3" Classes.solved="{Binding IsSolved}" BorderBrush="{DynamicResource MfRule}" BorderThickness="0,0,0,1">
                      <Border.Styles>
                        <Style Selector="Border.solved"><Setter Property="Background" Value="{DynamicResource MfSolved}"/></Style>
                      </Border.Styles>
                      <Grid ColumnDefinitions="*,84,62">
                        <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Label}"/><Run Text="  "/><Run Text="{Binding Symbol}" Foreground="Gray"/></TextBlock>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Formatted}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding Unit}" Opacity="0.7" Margin="6,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Rating table">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="6">
              <ComboBox ItemsSource="{x:Static vm:MainViewModel.RatingModes}" SelectedItem="{Binding RatingMode}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <TextBox Grid.Column="0" Classes="num" MinWidth="0" Text="{Binding RatingStart}" ToolTip.Tip="{Binding RatingStartLabel}" Watermark="Start"/>
                <TextBox Grid.Column="1" Classes="num" MinWidth="0" Text="{Binding RatingEnd}" ToolTip.Tip="{Binding RatingEndLabel}" Watermark="End"/>
                <TextBox Grid.Column="2" Classes="num" MinWidth="0" Text="{Binding RatingIncrement}" Watermark="Step"/>
              </Grid>
              <TextBlock Text="{Binding RatingStartLabel}" FontSize="11" Opacity="0.6"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Generate" Command="{Binding GenerateRatingTableCommand}"/>
                <Button Content="Copy" Command="{Binding CopyRatingTableCommand}"/>
                <Button Content="CSV…" Command="{Binding ExportRatingTableCsvCommand}"/>
              </StackPanel>
              <TextBlock Text="{Binding RatingStatus}" TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
            </StackPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*,*" Margin="0,8,0,2">
              <TextBlock Grid.Column="0" Text="Depth" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="1" Text="Q" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="V" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="Fr" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="4" Text="yc" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding RatingTable.Rows, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:RatingTableRow">
                    <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Depth, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="1" Text="{Binding Discharge, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="2" Text="{Binding Velocity, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="{Binding Froude, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="4" Text="{Binding CriticalDepth, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
