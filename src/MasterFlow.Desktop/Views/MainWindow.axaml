<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MasterFlow.Desktop.ViewModels"
        xmlns:c="using:MasterFlow.Desktop.Controls"
        xmlns:app="using:MasterFlow.Application"
        xmlns:dom="using:MasterFlow.Domain"
        x:Class="MasterFlow.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        Background="{DynamicResource MfPane}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}"/>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportReportCommand}"/>
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}"/>
    <KeyBinding Gesture="Ctrl+T" Command="{Binding AddCalculationCommand}"/>
  </Window.KeyBindings>

  <DockPanel>
    <!-- Command bar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource MfCard}" BorderBrush="{DynamicResource MfRule}" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="MasterFlow" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="4,0,16,0" Foreground="{DynamicResource MfAccent}"/>
        <Button Content="New" Command="{Binding NewProjectCommand}" ToolTip.Tip="New project (Ctrl+N)"/>
        <Button Content="Open…" Command="{Binding OpenCommand}" ToolTip.Tip="Open project (Ctrl+O)"/>
        <Button Content="Recent ▾" ToolTip.Tip="Recently opened projects">
          <Button.Flyout>
            <Flyout>
              <StackPanel MinWidth="320">
                <TextBlock Text="No recent projects" Opacity="0.6" IsVisible="{Binding NoRecentFiles}"/>
                <ItemsControl ItemsSource="{Binding RecentFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Content="Save" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)"/>
        <Button Content="Save as…" Command="{Binding SaveAsCommand}" ToolTip.Tip="Save as (Ctrl+Shift+S)"/>
        <Rectangle Width="1" Fill="{DynamicResource MfRule}" Margin="8,2"/>
        <Button Content="Undo" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)"/>
        <Button Content="Redo" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)"/>
        <Rectangle Width="1" Fill="{DynamicResource MfRule}" Margin="8,2"/>
        <Button Content="Copy results" Command="{Binding CopyResultsCommand}" ToolTip.Tip="Copy results as tab-separated text"/>
        <Button Content="Report…" Command="{Binding ExportReportCommand}" ToolTip.Tip="Selected calculation as PDF (or HTML) (Ctrl+E)"/>
        <Button Content="Batch report…" Command="{Binding ExportAllReportsCommand}" ToolTip.Tip="Every calculation in one PDF (or HTML)"/>
        <Button Content="Compare report…" Command="{Binding ExportComparisonReportCommand}" ToolTip.Tip="Side-by-side table of every calculation, PDF (or HTML)"/>
        <Button Content="Excel…" Command="{Binding ExportWorkbookCommand}" ToolTip.Tip="Workbook: comparison, one sheet per calculation, rating table"/>
        <Button Content="Log folder" Command="{Binding OpenLogFolderCommand}" ToolTip.Tip="Open the local log (kept on this computer only, 14 days)"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource MfCard}" BorderBrush="{DynamicResource MfRule}" BorderThickness="0,1,0,0" Padding="10,4">
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.8"/>
    </Border>

    <Grid ColumnDefinitions="260,4,*,4,370">
      <!-- Project navigator -->
      <DockPanel Grid.Column="0" Margin="8">
        <Expander DockPanel.Dock="Top" Header="Project information" Margin="0,0,0,8" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <TextBox AutomationProperties.Name="Project name" Watermark="Project name" Text="{Binding ProjectName}"/>
            <TextBox AutomationProperties.Name="Project number" Watermark="Project number" Text="{Binding ProjectNumber}"/>
            <TextBox AutomationProperties.Name="Client" Watermark="Client" Text="{Binding Client}"/>
            <TextBox AutomationProperties.Name="Prepared by" Watermark="Prepared by" Text="{Binding PreparedBy}"/>
            <TextBox AutomationProperties.Name="Checked by" Watermark="Checked by" Text="{Binding CheckedBy}"/>
            <TextBox AutomationProperties.Name="Report notes" Watermark="Report notes" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50"/>
            <TextBox AutomationProperties.Name="Report watermark" Watermark="Report watermark (e.g. PRELIMINARY)" Text="{Binding Watermark}"/>
            <TextBox AutomationProperties.Name="Report footer text" Watermark="Report footer text" Text="{Binding FooterText}"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="Logo…" Command="{Binding PickLogoCommand}" ToolTip.Tip="PNG, JPEG, GIF or SVG up to 1 MB, embedded in the project"/>
              <Button Content="Remove logo" Command="{Binding ClearLogoCommand}" IsVisible="{Binding HasLogo}"/>
            </StackPanel>
            <CheckBox Content="Include calculation trace in reports" IsChecked="{Binding IncludeCalculationTrace}"/>
          </StackPanel>
        </Expander>
        <WrapPanel DockPanel.Dock="Top" ItemSpacing="4" LineSpacing="4" Margin="0,0,0,6">
          <Button Content="+ Channel" Command="{Binding AddCalculationCommand}" ToolTip.Tip="Add calculation (Ctrl+T)"/>
          <Button Content="From template ▾" ToolTip.Tip="Add a calculation from a template">
            <Button.Flyout>
              <Flyout>
                <ScrollViewer MaxHeight="420">
                  <ItemsControl ItemsSource="{Binding Templates}" MinWidth="340">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="app:CalculationTemplate">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="✕" IsVisible="{Binding !BuiltIn}" AutomationProperties.Name="Remove from My templates" ToolTip.Tip="Remove from My templates" Background="Transparent"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteUserTemplateCommand}" CommandParameter="{Binding}"/>
                          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" ToolTip.Tip="{Binding Description}"
                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NewFromTemplateCommand}" CommandParameter="{Binding}">
                            <TextBlock><Run Text="{Binding Category}" Foreground="Gray"/><Run Text="  "/><Run Text="{Binding Name}"/></TextBlock>
                          </Button>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Content="Duplicate" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplicate (Ctrl+D)"/>
          <Button Content="Save as template" Command="{Binding SaveAsTemplateCommand}" ToolTip.Tip="Keep the selected calculation in My templates (per user, all projects)"/>
          <Button Content="Delete" Command="{Binding DeleteCommand}" ToolTip.Tip="Move to the recycle bin"/>
          <Button Content="Sort" Command="{Binding SortCommand}" ToolTip.Tip="Sort by folder, then title (2 before 10)"/>
        </WrapPanel>
        <Expander DockPanel.Dock="Bottom" Header="{Binding RecycleBinLabel}" IsVisible="{Binding HasRecycleBin}" HorizontalAlignment="Stretch" Margin="0,6,0,0">
          <StackPanel Spacing="2">
            <ItemsControl ItemsSource="{Binding RecycleBin}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dom:ChannelCalculation">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restore" Padding="6,2"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RestoreCommand}" CommandParameter="{Binding}"/>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Empty recycle bin" Command="{Binding EmptyRecycleBinCommand}"/>
          </StackPanel>
        </Expander>
        <ListBox AutomationProperties.Name="Calculations" ItemsSource="{Binding Calculations}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CalculationViewModel">
              <DockPanel Margin="0,2">
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IncludeInBatch}" AutomationProperties.Name="Include in batch outputs" MinWidth="0" Margin="0,0,6,0" VerticalAlignment="Center"
                          ToolTip.Tip="Include in the batch report, comparison and Excel workbook"/>
                <StackPanel>
                  <TextBlock Text="{Binding ListLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding ListDetail}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="{DynamicResource MfRule}"/>

      <!-- Calculation editor -->
      <ScrollViewer Grid.Column="2" IsVisible="{Binding HasSelection}">
        <StackPanel Margin="8" Spacing="8" DataContext="{Binding Selected}" x:DataType="vm:CalculationViewModel">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBox AutomationProperties.Name="Calculation title" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Watermark="Calculation title (may contain fields such as {Q:F1})" ToolTip.Tip="{x:Static vm:CalculationViewModel.TitleFieldHelp}"/>
              <TextBlock IsVisible="{Binding TitleHasFields}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"><Run Text="Title preview: "/><Run Text="{Binding DisplayTitle}" FontWeight="SemiBold"/></TextBlock>
              <TextBox AutomationProperties.Name="Folder" Text="{Binding Folder}" Watermark="Folder (optional, e.g. Ditches/Phase 1)"/>
              <TextBox AutomationProperties.Name="Description" Text="{Binding Description}" Watermark="Description (appears on the report)" AcceptsReturn="True" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,8,*">
            <Border Classes="card" Grid.Column="0">
              <StackPanel>
                <TextBlock Classes="h2" Text="Section" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Classes="label" Text="Shape"/>
                  <ComboBox AutomationProperties.Name="Section shape" Grid.Column="1" ItemsSource="{x:Static vm:CalculationViewModel.Shapes}" SelectedItem="{Binding Shape}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <TextBlock Grid.Row="1" Classes="label" Text="Units"/>
                  <ComboBox AutomationProperties.Name="Unit system" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:CalculationViewModel.UnitSystems}" SelectedItem="{Binding Units}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <TextBlock Grid.Row="2" Classes="label" Text="Bottom width b" IsVisible="{Binding ShowBottomWidth}"/>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowBottomWidth}">
                    <TextBox AutomationProperties.Name="Bottom width" Classes="num" Text="{Binding BottomWidth}"/><TextBlock Classes="unit" Text="{Binding LengthUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="3" Classes="label" Text="Left slope zL" IsVisible="{Binding ShowSideSlopes}"/>
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowSideSlopes}">
                    <TextBox AutomationProperties.Name="Left side slope, horizontal per 1 vertical" Classes="num" Text="{Binding LeftSlope}"/><TextBlock Classes="unit" Text="H : 1 V"/>
                  </StackPanel>
                  <TextBlock Grid.Row="4" Classes="label" Text="Right slope zR" IsVisible="{Binding ShowSideSlopes}"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowSideSlopes}">
                    <TextBox AutomationProperties.Name="Right side slope, horizontal per 1 vertical" Classes="num" Text="{Binding RightSlope}"/><TextBlock Classes="unit" Text="H : 1 V"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Classes="label" Text="Diameter D" IsVisible="{Binding IsPipe}"/>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding IsPipe}">
                    <TextBox AutomationProperties.Name="Pipe diameter" Classes="num" Text="{Binding Diameter}"/><TextBlock Classes="unit" Text="{Binding DiameterUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Classes="label" Text="Definition" IsVisible="{Binding IsEllipse}"/>
                  <CheckBox Grid.Row="2" Grid.Column="1" Content="ASTM C507 standard size" IsChecked="{Binding EllipseStandard}" IsVisible="{Binding IsEllipse}"/>
                  <TextBlock Grid.Row="4" Classes="label" Text="Orientation" IsVisible="{Binding ShowEllipseStandard}"/>
                  <CheckBox Grid.Row="4" Grid.Column="1" Content="Vertical (VE)" IsChecked="{Binding EllipseVertical}" IsVisible="{Binding ShowEllipseStandard}"/>
                  <TextBlock Grid.Row="3" Classes="label" Text="Standard size" IsVisible="{Binding ShowEllipseStandard}"/>
                  <ComboBox AutomationProperties.Name="Standard ellipse size" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding ShowEllipseStandard}"
                            ItemsSource="{x:Static vm:CalculationViewModel.EllipseSizes}" SelectedItem="{Binding EllipseSize}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="3" Classes="label" Text="Rise" IsVisible="{Binding ShowEllipseCustom}"/>
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowEllipseCustom}">
                    <TextBox AutomationProperties.Name="Ellipse rise" Classes="num" Text="{Binding EllipseRise}"/><TextBlock Classes="unit" Text="{Binding DiameterUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="4" Classes="label" Text="Span" IsVisible="{Binding ShowEllipseCustom}"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowEllipseCustom}">
                    <TextBox AutomationProperties.Name="Ellipse span" Classes="num" Text="{Binding EllipseSpan}"/><TextBlock Classes="unit" Text="{Binding DiameterUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Classes="label" Text="Composite n" IsVisible="{Binding IsIrregular}"/>
                  <ComboBox AutomationProperties.Name="Composite roughness method" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding IsIrregular}"
                            ItemsSource="{x:Static vm:CalculationViewModel.RoughnessMethods}" SelectedItem="{Binding RoughnessMethod}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2" IsVisible="{Binding IsIrregular}">
                    <TextBlock Classes="label" Text="Points: station, elevation, n to next point (optional), description. Paste from Excel."/>
                    <TextBox AutomationProperties.Name="Section points: station, elevation, optional n and description, one per line" Text="{Binding PointsText}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas,Menlo,monospace"
                             Height="170" TextWrapping="NoWrap" Watermark="0&#x09;5&#x0a;10&#x09;0 ..."/>
                  </StackPanel>
                  <TextBlock Grid.Row="5" Classes="label" Text="Channel depth" IsVisible="{Binding ShowChannelDepth}"/>
                  <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowChannelDepth}">
                    <TextBox AutomationProperties.Name="Channel depth" Classes="num" Text="{Binding ChannelDepth}" Watermark="optional"/><TextBlock Classes="unit" Text="{Binding LengthUnit}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card" Grid.Column="2">
              <StackPanel>
                <TextBlock Classes="h2" Text="Flow" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Classes="label" Text="Solve for"/>
                  <ComboBox AutomationProperties.Name="Solve for" Grid.Column="1" ItemsSource="{x:Static vm:CalculationViewModel.SolveModes}" SelectedItem="{Binding SolveFor}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <TextBlock Grid.Row="1" Classes="label" Text="Manning's n"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox AutomationProperties.Name="Manning's n" Classes="num" Text="{Binding ManningN}" IsVisible="{Binding RoughnessIsInput}"/><Border IsVisible="{Binding !RoughnessIsInput}" Background="{DynamicResource MfSolved}" CornerRadius="3" Padding="8,5" MinWidth="110"><TextBlock Text="{Binding SolvedValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Border>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Classes="label" Text="Slope S"/>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox AutomationProperties.Name="Channel slope in percent" Classes="num" Text="{Binding SlopePercent}" IsVisible="{Binding SlopeIsInput}"/><Border IsVisible="{Binding !SlopeIsInput}" Background="{DynamicResource MfSolved}" CornerRadius="3" Padding="8,5" MinWidth="110"><TextBlock Text="{Binding SolvedValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Border><TextBlock Classes="unit" Text="%"/>
                  </StackPanel>
                  <TextBlock Grid.Row="3" Classes="label" Text="Discharge Q"/>
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox AutomationProperties.Name="Discharge" Classes="num" Text="{Binding Discharge}" IsVisible="{Binding DischargeIsInput}"/><Border IsVisible="{Binding !DischargeIsInput}" Background="{DynamicResource MfSolved}" CornerRadius="3" Padding="8,5" MinWidth="110"><TextBlock Text="{Binding SolvedValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Border><TextBlock Classes="unit" Text="{Binding DischargeUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="4" Classes="label" Text="Depth y"/>
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBox AutomationProperties.Name="Flow depth" Classes="num" Text="{Binding Depth}" IsVisible="{Binding DepthIsInput}"/><Border IsVisible="{Binding !DepthIsInput}" Background="{DynamicResource MfSolved}" CornerRadius="3" Padding="8,5" MinWidth="110"><TextBlock Text="{Binding SolvedValueText}" FontWeight="SemiBold" HorizontalAlignment="Right"/></Border><TextBlock Classes="unit" Text="{Binding LengthUnit}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="5" Classes="label" Text="n reference" IsVisible="{Binding RoughnessIsInput}"/>
                  <ComboBox AutomationProperties.Name="Typical Manning's n reference" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding RoughnessIsInput}" PlaceholderText="Pick a typical n (Chow 1959)…"
                            ItemsSource="{x:Static vm:CalculationViewModel.RoughnessEntries}" SelectedItem="{Binding RoughnessPick}" MaxDropDownHeight="420">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="dom:RoughnessEntry"><StackPanel><TextBlock Text="{Binding Description}"/><TextBlock FontSize="11" Opacity="0.65"><Run Text="{Binding Category}"/><Run Text=" · normal "/><Run Text="{Binding Normal, StringFormat={}{0:0.000}}"/><Run Text=" · range "/><Run Text="{Binding Range}"/></TextBlock></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="6" Classes="label" Text="Invert elevation" IsVisible="{Binding ShowInvertElevation}"/>
                  <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ShowInvertElevation}">
                    <TextBox AutomationProperties.Name="Invert elevation" Classes="num" Text="{Binding InvertElevation}" Watermark="optional"/><TextBlock Classes="unit" Text="{Binding LengthUnit}"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="The highlighted field is the unknown being solved for." FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card" Height="330">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top">
                <CheckBox DockPanel.Dock="Right" Content="True scale" x:Name="TrueScaleBox"/>
                <TextBlock Classes="h2" Text="Cross-section" Margin="0"/>
              </DockPanel>
              <c:CrossSectionView Drawing="{Binding Drawing}" Section="{Binding CurrentSection}" LengthUnit="{Binding LengthUnit}"
                                  TrueScale="{Binding #TrueScaleBox.IsChecked, FallbackValue=False}"/>
            </DockPanel>
          </Border>

          <Border Classes="card">
            <StackPanel>
              <TextBlock Classes="h2" Text="Messages" Margin="0,0,0,4"/>
              <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MessageItem">
                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <Expander Header="Calculation trace (method, bracket, iterations)" HorizontalAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding Trace}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Margin="0,1"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="3" Background="{DynamicResource MfRule}"/>

      <!-- Results + rating table -->
      <TabControl Grid.Column="4" Margin="4,0,8,8" IsVisible="{Binding HasSelection}">
        <TabItem Header="Results">
          <ScrollViewer>
            <StackPanel DataContext="{Binding Selected}" x:DataType="vm:CalculationViewModel">
              <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding ResultLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:ResultLine">
                    <Border Padding="6,3" Classes.solved="{Binding IsSolved}" BorderBrush="{DynamicResource MfRule}" BorderThickness="0,0,0,1">
                      <Border.Styles>
                        <Style Selector="Border.solved"><Setter Property="Background" Value="{DynamicResource MfSolved}"/></Style>
                      </Border.Styles>
                      <Grid ColumnDefinitions="*,84,62">
                        <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Label}"/><Run Text="  "/><Run Text="{Binding Symbol}" Foreground="Gray"/></TextBlock>
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Formatted}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{Binding Unit}" Opacity="0.7" Margin="6,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Compare">
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Every calculation in the project, side by side. Values use each calculation's own units." FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Width="150" Text="Quantity" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding Comparison.Titles, FallbackValue={x:Null}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Width="96" Text="{Binding}" FontWeight="SemiBold" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Comparison.Rows, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:ComparisonRow">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                      <TextBlock Width="150" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Group}"><Run Text="{Binding Label}"/><Run Text=" "/><Run Text="{Binding Unit}" Foreground="Gray"/></TextBlock>
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Width="96" Text="{Binding}" TextAlignment="Right"/></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Comparison.Notes, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Rating table">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="6">
              <ComboBox AutomationProperties.Name="Rating table mode" ItemsSource="{x:Static vm:MainViewModel.RatingModes}" SelectedItem="{Binding RatingMode}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <TextBox AutomationProperties.Name="Rating table start" Grid.Column="0" Classes="num" MinWidth="0" Text="{Binding RatingStart}" ToolTip.Tip="{Binding RatingStartLabel}" Watermark="Start"/>
                <TextBox AutomationProperties.Name="Rating table end" Grid.Column="1" Classes="num" MinWidth="0" Text="{Binding RatingEnd}" ToolTip.Tip="{Binding RatingEndLabel}" Watermark="End"/>
                <TextBox AutomationProperties.Name="Rating table step" Grid.Column="2" Classes="num" MinWidth="0" Text="{Binding RatingIncrement}" Watermark="Step"/>
              </Grid>
              <TextBlock Text="{Binding RatingStartLabel}" FontSize="11" Opacity="0.6"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Generate" Command="{Binding GenerateRatingTableCommand}"/>
                <Button Content="Copy" Command="{Binding CopyRatingTableCommand}"/>
                <Button Content="CSV…" Command="{Binding ExportRatingTableCsvCommand}"/>
              </StackPanel>
              <TextBlock Text="{Binding RatingStatus}" TextWrapping="Wrap" FontSize="11" Opacity="0.8"/>
            </StackPanel>
            <c:RatingChartView DockPanel.Dock="Top" Height="190" Margin="0,8,0,0" Table="{Binding RatingTable}"
                               LengthUnit="{Binding Selected.LengthUnit, FallbackValue=ft}" DischargeUnit="{Binding Selected.DischargeUnit, FallbackValue=cfs}"/>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*,*,*,*" Margin="0,8,0,2">
              <TextBlock Grid.Column="0" Text="Depth" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="1" Text="Q" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="V" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Text="Fr" FontWeight="SemiBold" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="4" Text="yc" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding RatingTable.Rows, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:RatingTableRow">
                    <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Depth, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="1" Text="{Binding Discharge, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="2" Text="{Binding Velocity, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="{Binding Froude, StringFormat={}{0:F2}}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Column="4" Text="{Binding CriticalDepth, StringFormat={}{0:F3}}" HorizontalAlignment="Right"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
