<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MasterFlow.Desktop.ViewModels"
        xmlns:c="using:MasterFlow.Desktop.Controls"
        xmlns:hyd="using:MasterFlow.Hydraulics"
        x:Class="MasterFlow.Desktop.Views.NetworkWindow"
        x:DataType="vm:MainViewModel"
        Title="Storm networks: HGL / EGL — MasterFlow"
        Width="1400" Height="880" MinWidth="900" MinHeight="600"
        Background="{DynamicResource MfPane}">
  <Window.Styles>
    <Style Selector="TextBlock.cell"><Setter Property="Width" Value="84"/><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style Selector="TextBlock.head"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="None"/></Style>
    <Style Selector="TextBox.grid"><Setter Property="FontFamily" Value="Consolas,Menlo,monospace"/><Setter Property="FontSize" Value="12"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="AcceptsTab" Value="True"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource MfCard}" BorderBrush="{DynamicResource MfRule}" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="Network" VerticalAlignment="Center" Margin="4,0"/>
        <ComboBox AutomationProperties.Name="Storm network" MinWidth="220" ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:NetworkViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="New" Command="{Binding NewNetworkCommand}" ToolTip.Tip="Add an empty storm network"/>
        <Button Content="Delete" Command="{Binding DeleteNetworkCommand}" ToolTip.Tip="Delete the selected network"/>
        <Rectangle Width="1" Fill="{DynamicResource MfRule}" Margin="8,2"/>
        <Button Content="Solve" Command="{Binding SelectedNetwork.SolveCommand, FallbackValue={x:Null}}" ToolTip.Tip="Compute the HGL and EGL (F5)" FontWeight="SemiBold"/>
        <Button Content="Report…" Command="{Binding ExportNetworkReportCommand}" ToolTip.Tip="Profiles and tables as PDF (or HTML)"/>
        <Button Content="Copy tables" Command="{Binding CopyNetworkResultsCommand}" ToolTip.Tip="Pipes and structures tables, tab-separated"/>
        <Rectangle Width="1" Fill="{DynamicResource MfRule}" Margin="8,2"/>
        <Button Content="Size pipes" Command="{Binding SelectedNetwork.SizePipesCommand, FallbackValue={x:Null}}" ToolTip.Tip="Smallest standard circular sizes that meet the criteria (inverts kept); changes listed on the Sizing tab"/>
        <Button Content="Undo sizing" Command="{Binding SelectedNetwork.UndoSizingCommand, FallbackValue={x:Null}}" IsEnabled="{Binding SelectedNetwork.CanUndoSizing, FallbackValue=False}"/>
        <Button Content="LandXML…" Command="{Binding ExportNetworkLandXmlCommand}" ToolTip.Tip="Export the pipe network to LandXML for Civil 3D (Insert → LandXML), with HGL/EGL results as PipeFlow/StructFlow and Feature properties"/>
        <Button Content="Civil 3D results…" Command="{Binding ExportCivil3DResultsCommand}" ToolTip.Tip="AutoLISP command MFHGL that writes HGL/EGL and flow onto the drawing's pipes by name, plus a CSV of all results"/>
        <Button Content="Excel…" Command="{Binding ExportWorkbookCommand}" ToolTip.Tip="Project workbook including network pipes, structures and profile points"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource MfCard}">
      <SelectableTextBlock Text="{Binding SelectedNetwork.Status, FallbackValue='Add a network with New, or import a LandXML pipe network from the main window.'}" TextWrapping="Wrap"/>
    </Border>

    <Grid ColumnDefinitions="520,4,*" IsVisible="{Binding SelectedNetwork, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ScrollViewer Grid.Column="0" Margin="8,8,0,8">
        <StackPanel Spacing="6" DataContext="{Binding SelectedNetwork}" x:DataType="vm:NetworkViewModel">
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
            <TextBlock Text="Name" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding Name}" AutomationProperties.Name="Network name"/>
            <TextBlock Grid.Row="1" Text="Units" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:NetworkViewModel.UnitSystems}" SelectedItem="{Binding Units}" AutomationProperties.Name="Unit system">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Text="Tailwater" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:NetworkViewModel.TailwaterRules}" SelectedItem="{Binding Tailwater}" AutomationProperties.Name="Tailwater rule" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="x:Object"><TextBlock Text="{Binding Converter={x:Static c:EnumDisplayConverter.Instance}}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="3" Text="TW elevation" VerticalAlignment="Center" IsVisible="{Binding IsElevationTailwater}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TailwaterElevation}" IsVisible="{Binding IsElevationTailwater}" AutomationProperties.Name="Tailwater elevation"/>
            <TextBlock Grid.Row="4" Text="Default K" VerticalAlignment="Center" ToolTip.Tip="K for structures set to StandardK without their own K (hs = K·Vo²/2g)"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DefaultJunctionK}" AutomationProperties.Name="Default junction K"/>
            <TextBlock Grid.Row="5" Text="Minor storm" VerticalAlignment="Center" ToolTip.Tip="Name of the check storm whose flows (Q minor, minor inflow) are used for the minimum-velocity check"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MinorStormName}" AutomationProperties.Name="Minor storm name"/>
          </Grid>

          <Border Classes="card">
            <StackPanel Spacing="4">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Rapid City IDCM 2012" Command="{Binding ApplyRapidCityCommand}" ToolTip.Tip="HGL 1 ft below rim, 2.5 to 20 fps, 12 in. minimum, slopes below critical, no surcharge"/>
                <TextBlock Text="Design criteria" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid ColumnDefinitions="*,90,*,90" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                <TextBlock Text="HGL below rim" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding HglBelowRim}" Watermark="{Binding LengthUnit}" AutomationProperties.Name="Required HGL below rim"/>
                <TextBlock Grid.Column="2" Text="EGL below rim" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Text="{Binding EglBelowRim}" Watermark="{Binding LengthUnit}" AutomationProperties.Name="Required EGL below rim"/>
                <TextBlock Grid.Row="1" Text="Min velocity" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinVelocity}" Watermark="{Binding VelocityUnit}" AutomationProperties.Name="Minimum velocity"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Max velocity" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MaxVelocity}" Watermark="{Binding VelocityUnit}" AutomationProperties.Name="Maximum velocity"/>
                <TextBlock Grid.Row="2" Text="Min pipe size" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MinPipeSize}" Watermark="{Binding SizeUnit}" AutomationProperties.Name="Minimum pipe size"/>
                <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="Allow pressure flow" IsChecked="{Binding AllowSurcharge}"/>
                <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Flag supercritical slopes" IsChecked="{Binding FlagSupercritical}"/>
              </Grid>
              <TextBox Text="{Binding CriteriaSource}" Watermark="Criteria source (shown on reports)" AutomationProperties.Name="Criteria source"/>
            </StackPanel>
          </Border>

          <TextBlock Text="Pipes (one per line; tab, semicolon or comma separated; paste from Excel)" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding PipesHeader}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
          <TextBox Classes="grid" Text="{Binding PipesText}" MinHeight="150" AutomationProperties.Name="Pipes table"/>
          <TextBlock Text="Structures" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding StructuresHeader}" FontSize="11" Opacity="0.7"/>
          <TextBox Classes="grid" Text="{Binding StructuresText}" MinHeight="120" AutomationProperties.Name="Structures table"/>
          <TextBlock Text="{x:Static vm:NetworkViewModel.LossMethods}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding InputErrors}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Foreground="#B3261E" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" Background="{DynamicResource MfRule}"/>

      <TabControl Grid.Column="2" Margin="4,0,8,8" DataContext="{Binding SelectedNetwork}" x:DataType="vm:NetworkViewModel">
        <TabItem Header="Profile">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
              <TextBlock Text="Path from" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding Paths}" SelectedItem="{Binding SelectedPath}" MinWidth="160" AutomationProperties.Name="Profile path start"/>
              <TextBlock Text="to the outfall" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding CriteriaSummary}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <c:NetworkProfileView Profile="{Binding Profile}" LengthUnit="{Binding LengthUnit}" MinHeight="300"/>
          </DockPanel>
        </TabItem>
        <TabItem Header="Pipes">
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding PipeColumns}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Classes="cell head" Text="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding PipeRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NetworkTableRow">
                    <Border BorderBrush="{DynamicResource MfRule}" BorderThickness="0,0,0,1" Padding="0,2">
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Classes="cell" Text="{Binding}" ToolTip.Tip="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Structures">
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding StructureColumns}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Classes="cell head" Text="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding StructureRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NetworkTableRow">
                    <Border BorderBrush="{DynamicResource MfRule}" BorderThickness="0,0,0,1" Padding="0,2" Classes.fails="{Binding Fails}">
                      <Border.Styles><Style Selector="Border.fails"><Setter Property="Background" Value="#33B3261E"/></Style></Border.Styles>
                      <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Classes="cell" Text="{Binding}" ToolTip.Tip="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding CriteriaSummary}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Sizing">
          <ScrollViewer>
            <StackPanel>
              <TextBlock Text="Size pipes: smallest standard circular size carrying the design Q part full (when pressure flow is not allowed) within the velocity limits, never smaller than a pipe upstream, then larger pipes where the HGL is too close to a rim. Inverts, n, lengths and elliptical pipes are kept; no crown is put above a rim." TextWrapping="Wrap" FontSize="11" Opacity="0.75" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding SizingReport}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Messages">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Messages}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="hyd:CalcMessage">
                  <SelectableTextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="{Binding Severity}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Code}" Foreground="Gray"/><Run Text="  "/><Run Text="{Binding Text}"/></SelectableTextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Trace">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Trace}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><SelectableTextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
